{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "target": "alfa-news",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/news-card/**",
        "function": {
          "functionId": "getNewsCardImage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/news/**",
        "function": {
          "functionId": "shareNews",
          "region": "asia-south1"
        }
      },
      {
        "source": "/ad/**",
        "function": {
          "functionId": "shareNews",
          "region": "asia-south1"
        }
      },
      {
        "source": "/verify",
        "function": {
          "functionId": "verifyReporter",
          "region": "asia-south1"
        }
      },
      {
        "source": "/verify/**",
        "function": {
          "functionId": "verifyReporter",
          "region": "asia-south1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "serveSitemap",
          "region": "asia-south1"
        }
      },
      {
        "source": "/ads.txt",
        "destination": "/ads.txt"
      },
      {
        "source": "/app-ads.txt",
        "destination": "/app-ads.txt"
      },
      {
        "source": "/robots.txt",
        "destination": "/robots.txt"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
